{
  "name": "dsh-zotero-paperbridge",
  "version": "0.2.0",
  "description": "DSH 原生 Zotero 连接：文献检索、DOI/PMID 解析、去重、保存与回读验证",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png",
    "NOTICE",
    "icons-sources.json"
  ],
  "icon": "./icon.png",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "XZJ-top",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XZJ-top/dsh-zotero-paperbridge.git"
  },
  "bugs": {
    "url": "https://github.com/XZJ-top/dsh-zotero-paperbridge/issues"
  },
  "homepage": "https://github.com/XZJ-top/dsh-zotero-paperbridge#readme"
}
